# GoHighLevel MCP Server — Environment Configuration
# Copy this file to .env and fill in your values

# -------------------------------------------------------
# REQUIRED: Your GoHighLevel v2 Private API Key
# Found in: GHL > Settings > Business Profile > API Keys
# -------------------------------------------------------
GHL_API_KEY=your_api_key_here

# -------------------------------------------------------
# REQUIRED: Your GoHighLevel Location (Sub-Account) ID
# Found in: GHL > Settings > Business Profile > Location ID
# -------------------------------------------------------
GHL_LOCATION_ID=your_location_id_here

# -------------------------------------------------------
# OPTIONAL: Override the base API URL (default shown)
# -------------------------------------------------------
GHL_BASE_URL=https://services.leadconnectorhq.com

# -------------------------------------------------------
# OPTIONAL: API version header (default shown)
# -------------------------------------------------------
GHL_API_VERSION=2021-07-28
